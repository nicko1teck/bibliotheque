# Copy this file to "server/.env" for local development and fill in real values.
# server/.env is git-ignored. NEVER commit real credentials.
# In production, supply these as real environment variables instead
# (see ecosystem.config.example.js).

# MySQL connection (all four are required; the server will not start without them)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Optional
# Port the server listens on (default 4000)
# PORT=4000

# Comma-separated list of origins allowed to call the API.
# If unset, any origin is allowed.
# CORS_ORIGIN=http://localhost:3000
